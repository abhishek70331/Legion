# Server Configuration
PORT=5000
NODE_ENV=production

# Database Connection (PostgreSQL / Supabase / Neon / Render)
DATABASE_URL=postgresql://username:password@hostname:5432/database_name
DATABASE_SSL=true

# Cryptographic Secret (Minimum 32 random characters)
JWT_SECRET=replace_with_a_secure_random_32_plus_character_secret_key

# Allowed CORS Origins (comma-separated)
FRONTEND_URL=http://localhost:5173,http://localhost:5000

# Concurrency Policy (active sessions per user account)
MAX_ACTIVE_SESSIONS=1
